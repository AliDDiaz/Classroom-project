<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ChatBotProject.controllers.UserDashboardController"
      alignment="CENTER"
      spacing="15"
      prefHeight="400"
      prefWidth="600">

    <Label fx:id="labelWelcome"
           text="Bienvenido"/>

    <TextArea fx:id="chatArea"
              prefHeight="250"
              editable="false"
              wrapText="true"/>

    <TextField fx:id="inputField"
               promptText="Escribe un mensaje para FitBot..."/>

    <Button text="Enviar"
            onAction="#sendMessage"/>

    <Button text="Salud"
            onAction="#openHealth"
            prefWidth="200"/>

    <Button text="Hábitos"
            onAction="#openHabits"
            prefWidth="200"/>

    <Button text="Objetivos"
            onAction="#openGoals"
            prefWidth="200"/>

</VBox>