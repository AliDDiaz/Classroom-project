<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600" prefWidth="800" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ChatBotProject.controllers.MainController">

    <!-- ===== ENCABEZADO ===== -->
    <top>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <Label style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" text="🤖 FitTracker App" />
            <Label style="-fx-text-fill: #bdc3c7; -fx-font-size: 13px;" text="Gestión de usuarios" />
        </VBox>
    </top>

    <!-- ===== CENTRO: tabla de usuarios ===== -->
    <center>
        <VBox spacing="10" style="-fx-padding: 15;">

            <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Lista de usuarios registrados" />

            <TableView fx:id="userTable" prefHeight="380">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="60" text="ID" />
                    <TableColumn fx:id="colName" prefWidth="160" text="Nombre" />
                    <TableColumn fx:id="colAge" prefWidth="80" text="Edad" />
                    <TableColumn fx:id="colWeight" prefWidth="80" text="Peso" />
                    <TableColumn fx:id="colHeight" prefWidth="80" text="Altura" />
                    <TableColumn fx:id="colGender" prefWidth="100" text="Género" />
                    <TableColumn fx:id="colGoal" prefWidth="180" text="Objetivo principal" />
                </columns>
            </TableView>
            <Button fx:id="btnClear" onAction="#handleClear" prefWidth="200" style="-fx-background-color: #7f8c8d; -fx-text-fill: white;" text="Limpiar campos" />

        </VBox>
    </center>

    <!-- ===== PANEL DERECHO: formulario ===== -->
    <right>
        <VBox prefWidth="220" spacing="10" style="-fx-padding: 15; -fx-background-color: #ecf0f1;">

            <Label style="-fx-font-size: 13px; -fx-font-weight: bold;" text="Datos del usuario" />

            <Label text="ID (búsqueda / eliminar):" />
            <TextField fx:id="fieldId" promptText="Ej: 1" />

            <Label text="Nombre:" />
            <TextField fx:id="fieldName" promptText="Ej: Juan Pérez" />

            <Label text="Edad:" />
            <TextField fx:id="fieldAge" promptText="Ej: 25" />

            <Label text="Peso (kg):" />
            <TextField fx:id="fieldWeight" promptText="Ej: 70.5" />

            <Label text="Altura (m):" />
            <TextField fx:id="fieldHeight" promptText="Ej: 1.75" />

            <Label text="Género:" />
            <ComboBox fx:id="fieldGender" prefWidth="200" />

            <!-- ===== BOTONES CRUD ===== -->
            <HBox spacing="8" style="-fx-padding-top: 10;">
                <Button fx:id="btnCreate" onAction="#handleCreate" prefWidth="95" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="Registrar" />
                <Button fx:id="btnDelete" onAction="#handleDelete" prefWidth="95" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="Eliminar" />
            </HBox>
            <Button fx:id="btnUpdate" onAction="#handleUpdate" prefWidth="200" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold;" text="Actualizar peso" />
            <Button fx:id="btnSearch" onAction="#handleSearch" prefWidth="200" style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-font-weight: bold;" text="Buscar por ID" />
            <Button onAction="#openHealthWindow" prefWidth="200" text="Salud" />

            <Button onAction="#openHabitsWindow" prefWidth="200" text="Hábitos" />

            <Button onAction="#openGoalsWindow" prefWidth="200" text="Objetivos" />

        </VBox>
    </right>

    <!-- ===== PIE ===== -->
    <bottom>
        <VBox spacing="5" style="-fx-background-color: #2c3e50; -fx-padding: 8;">

            <Label fx:id="labelStatus" style="-fx-text-fill: #bdc3c7; -fx-font-size: 12px;" text="Listo." />

            <TextArea fx:id="resultArea" prefHeight="150" wrapText="true" />
        </VBox>
    </bottom>

</BorderPane>
