<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ChatBotProject.controllers.RegisterController"
      spacing="10"
      alignment="CENTER">

    <Label text="Registro de Usuario"/>

    <TextField fx:id="fieldName"
               promptText="Nombre"/>

    <TextField fx:id="fieldAge"
               promptText="Edad"/>

    <TextField fx:id="fieldWeight"
               promptText="Peso"/>

    <TextField fx:id="fieldHeight"
               promptText="Altura"/>

    <ComboBox fx:id="fieldGender"/>

    <Button text="Crear Cuenta"
            onAction="#register"/>

    <Label fx:id="statusLabel"/>

</VBox>