<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="301.0" prefWidth="175.0" spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ChatBotProject.controllers.RegisterController">

    <Label text="Registro de Usuario" />

    <TextField fx:id="fieldName" promptText="Nombre" />

    <TextField fx:id="fieldAge" promptText="Edad" />

    <TextField fx:id="fieldWeight" promptText="Peso" />

    <TextField fx:id="fieldHeight" promptText="Altura" />

    <ComboBox fx:id="fieldGender" promptText="genero" />

    <Button onAction="#register" text="Crear Cuenta" />

    <Label fx:id="statusLabel" />

</VBox>
