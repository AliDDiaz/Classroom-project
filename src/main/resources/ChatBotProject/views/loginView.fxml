<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="361.0" prefWidth="407.0" spacing="15" style="-fx-padding:30; -fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ChatBotProject.controllers.LoginController">

    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="🤖 FitTracker App" />

    <Label style="-fx-font-size: 13px; -fx-text-fill: #555555;" text="Inicia sesión con tu ID de usuario" />

    <TextField fx:id="fieldId" prefWidth="200" promptText="Ej: 1" style="-fx-alignment: center;" />

    <Button onAction="#handleLogin" prefWidth="200" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="Iniciar sesión" />

    <Label style="-fx-font-size: 12px; -fx-text-fill: #777777;" text="¿No tienes una cuenta?" />

    <Button onAction="#handleRegister" prefWidth="200" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold;" text="Registrarme" />

    <Button onAction="#handleAdminLogin" text="Administrador" />

    <Label fx:id="labelStatus" style="-fx-text-fill: #c0392b; -fx-font-size: 12px;" text="" />

</VBox>
