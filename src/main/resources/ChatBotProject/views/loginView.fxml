<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ChatBotProject.controllers.LoginController"
      spacing="15"
      alignment="CENTER"
      prefWidth="400"
      prefHeight="320"
      style="-fx-padding:30; -fx-background-color: #ecf0f1;">

    <Label text="🤖 Entrenador Personal"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <Label text="Inicia sesión con tu ID de usuario"
           style="-fx-font-size: 13px; -fx-text-fill: #555555;"/>

    <TextField fx:id="fieldId"
               promptText="Ej: 1"
               prefWidth="200"
               style="-fx-alignment: center;"/>

    <Button text="Iniciar sesión"
            onAction="#handleLogin"
            prefWidth="200"
            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>

    <Label text="¿No tienes una cuenta?"
           style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>

    <Button text="Registrarme"
            onAction="#handleRegister"
            prefWidth="200"
            style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold;"/>

    <Button text="Administrador"
            onAction="#handleAdminLogin"/>

    <Label fx:id="labelStatus"
           text=""
           style="-fx-text-fill: #c0392b; -fx-font-size: 12px;"/>

</VBox>
