<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ChatBotProject.controllers.HealthController"
      spacing="10"
      prefWidth="500"
      prefHeight="500"
      style="-fx-padding:15;">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Salud y Progreso"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <!-- ===== CONSULTAS BASICAS ===== -->
    <HBox spacing="8">
        <Button text="Ver IMC"
                onAction="#showBMI"
                prefWidth="115"/>

        <Button text="Ver Calorías"
                onAction="#showCalories"
                prefWidth="115"/>
    </HBox>

    <HBox spacing="8">
        <Button text="Ver Historial"
                onAction="#showHistory"
                prefWidth="115"/>

        <Button text="Ver Progreso"
                onAction="#showProgress"
                prefWidth="115"/>
    </HBox>

    <!-- ===== META DE PESO ===== -->
    <Label text="Meta de peso:"
           style="-fx-font-weight: bold;"/>

    <HBox spacing="8">
        <TextField fx:id="fieldTargetWeight"
                   promptText="Ej: 65.0"
                   prefWidth="120"/>

        <Button text="Configurar meta"
                onAction="#configureTargetWeight"
                prefWidth="140"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>

        <Button text="Ver progreso de meta"
                onAction="#showGoalProgress"
                prefWidth="150"/>
    </HBox>

    <TextArea fx:id="resultArea"
              prefHeight="250"
              wrapText="true"
              editable="false"/>

    <Label fx:id="labelStatus"
           text="Listo."
           style="-fx-text-fill: #555555;"/>

</VBox>
