<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ChatBotProject.controllers.HealthController"
      spacing="10"
      prefWidth="500"
      prefHeight="400"
      style="-fx-padding:15;">

    <Button text="Ver IMC"
            onAction="#showBMI"/>

    <Button text="Ver Historial"
            onAction="#showHistory"/>

    <Button text="Ver Progreso"
            onAction="#showProgress"/>

    <TextArea fx:id="resultArea"
              prefHeight="300"/>

</VBox>